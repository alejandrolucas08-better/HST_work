# =============================================================================
# HST EPI — Variáveis de ambiente
# Copie para `.env` (desenvolvimento) e configure os mesmos nomes no provedor
# de deploy (Vercel/Render/Railway). Nunca versione o arquivo `.env`.
# =============================================================================

# --- Aplicação -------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="HST EPI"
APP_TIME_ZONE=America/Sao_Paulo

# Segredo usado para assinar o JWT de sessão (cookie httpOnly).
# Gere com: openssl rand -base64 32
# Troque obrigatoriamente em produção. Mínimo de 32 caracteres.
AUTH_SECRET=dev-only-change-me-0000000000000000000000000000
AUTH_SESSION_TTL_HOURS=8

# Proteção contra força bruta no login (rate limit em memória por IP + e-mail).
# AUTH_LOGIN_MAX_ATTEMPTS vale por e-mail+IP; AUTH_LOGIN_IP_MAX_ATTEMPTS limita
# o total por IP (contém ataques distribuídos entre vários e-mails).
AUTH_LOGIN_MAX_ATTEMPTS=8
AUTH_LOGIN_IP_MAX_ATTEMPTS=40
AUTH_LOGIN_WINDOW_MINUTES=15

# Proteção contra força bruta na validação de PIN de entrega.
# A chave combina o usuário autenticado + o colaborador alvo.
AUTH_PIN_MAX_ATTEMPTS=5
AUTH_PIN_WINDOW_MINUTES=10

# CORS restritivo da API. A própria origem (APP_URL) é sempre permitida.
# Liste origens extras separadas por vírgula; deixe vazio para same-origin only.
# Ex.: CORS_ALLOWED_ORIGINS="https://app.exemplo.com,https://admin.exemplo.com"
CORS_ALLOWED_ORIGINS=

# Exibe as credenciais de demonstração na tela de login (use apenas em dev).
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=true

# --- Banco de dados (PostgreSQL / Supabase) --------------------------------
# Produção no Supabase:
#   DATABASE_URL  -> Transaction Pooler (porta 6543) para o runtime serverless.
#   DIRECT_URL    -> conexão direta (porta 5432) usada por migrações.
# Em Docker/local, ambas podem apontar para o mesmo PostgreSQL.
#
# Formato Supabase (substitua [REF], [REGIAO] e [SENHA]):
# DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
# DIRECT_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?schema=public"

# Docker Compose local (padrão do projeto):
DATABASE_URL="postgresql://hst:hst@localhost:5432/hst_epi?schema=public"
DIRECT_URL="postgresql://hst:hst@localhost:5432/hst_epi?schema=public"

# --- Empresa / documentos PDF ----------------------------------------------
# Dados usados no cabeçalho institucional da Ficha de EPI e do relatório PDF.
COMPANY_NAME="HST Segurança do Trabalho"
COMPANY_CNPJ="00.000.000/0001-00"
COMPANY_ADDRESS="Av. Industrial, 1000 - Distrito Industrial"
COMPANY_CITY="São Paulo"
COMPANY_STATE="SP"
COMPANY_CEP="00000-000"
COMPANY_PHONE="(11) 0000-0000"
COMPANY_EMAIL="sst@hst.local"
COMPANY_RESPONSIBLE_NAME="Administrador HST"
COMPANY_RESPONSIBLE_ROLE="Técnico de Segurança do Trabalho"

# --- Seed (dados iniciais) -------------------------------------------------
# Usados por `npm run db:seed`. Em produção, troque as senhas após o primeiro acesso.
SEED_ADMIN_NAME="Administrador HST"
SEED_ADMIN_EMAIL=admin@hst.local
SEED_ADMIN_PASSWORD=Admin@123

SEED_ALMOXARIFE_NAME="Almoxarife HST"
SEED_ALMOXARIFE_EMAIL=almoxarife@hst.local
SEED_ALMOXARIFE_PASSWORD=Almox@123

# --- Observabilidade (opcional) -------------------------------------------
# Deixe vazio para desabilitar. O endpoint /api/health já serve para uptime checks.
# SENTRY_DSN=
