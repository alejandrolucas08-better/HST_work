{
  "name": "hst-epi",
  "version": "0.1.0",
  "private": true,
  "description": "Gestão Inteligente de EPIs com controle de validade e entrega digital.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
